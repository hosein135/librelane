# Force LF for scripts and Nix (WSL / Linux runners)
*.sh text eol=lf
*.nix text eol=lf

# Source and web assets — LF so Windows editors do not introduce CRLF
*.py text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.v text eol=lf
*.sv text eol=lf
*.tcl text eol=lf
*.ipynb text eol=lf

# Gitignore / attributes themselves
.gitignore text eol=lf
.gitattributes text eol=lf
